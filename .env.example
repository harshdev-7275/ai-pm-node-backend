# Required — app will crash on startup if any of these are missing
NODE_ENV=development
PORT=4000

# Neon PostgreSQL — pooled connection for queries
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Neon PostgreSQL — direct connection for migrations (used by drizzle-kit)
DIRECT_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# JWT — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS — URL of the frontend app
CORS_ORIGIN=http://localhost:5173

# API URL — for Swagger/OpenAPI documentation
# Development: auto-configured as http://localhost:PORT
# Production: set to your deployed backend URL
API_URL=https://api.example.com

# Logging
LOG_LEVEL=info
