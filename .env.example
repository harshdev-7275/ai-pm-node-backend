# Required — app will crash on startup if any of these are missing
NODE_ENV=development
PORT=4000

# Neon PostgreSQL — pooled connection for queries
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Neon PostgreSQL — direct connection for migrations (used by drizzle-kit)
DIRECT_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# JWT — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS — frontend origin(s). Comma-separate multiple values.
# Development:  CORS_ORIGIN=http://localhost:5173
# Production:   CORS_ORIGIN=https://your-frontend.vercel.app
# Multiple:     CORS_ORIGIN=https://your-frontend.vercel.app,https://preview.your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173,https://ai-pm-frontend-git-main-harshdev7275s-projects.vercel.app/

# API URL — for Swagger/OpenAPI documentation
# Development: auto-configured as http://localhost:PORT
# Production: set to your deployed backend URL
API_URL=https://api.example.com

# Logging
LOG_LEVEL=info

AI_SERVICE_URL=http://localhost:8000

# Cloudflare R2 (S3-compatible) — user avatar storage (private bucket)
# All four required for avatar uploads; if unset, upload endpoints return 503.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=planiqo-avatars-dev
